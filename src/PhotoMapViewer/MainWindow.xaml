<Window x:Class="PhotoMapViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Photo Map Viewer"
        Width="1400" Height="860" MinWidth="700" MinHeight="420"
        Background="#0E0F11"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PhotoCol" Width="62*" MinWidth="200" />
            <ColumnDefinition x:Name="SplitCol" Width="5" />
            <ColumnDefinition x:Name="MapCol" Width="38*" MinWidth="160" />
        </Grid.ColumnDefinitions>

        <!-- Photo side -->
        <Grid x:Name="PhotoArea" Grid.Column="0" Background="Black" ClipToBounds="True">
            <Image x:Name="ImgBack" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            <Image x:Name="ImgFront" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Caption -->
            <Border x:Name="Caption" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Margin="18" Padding="14,9" CornerRadius="8"
                    Background="{StaticResource OverlayBrush}" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="CaptionPlace" Foreground="White" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CaptionDate" Foreground="#D6D6D6" FontSize="14" Margin="0,2,0,0" />
                    <TextBlock x:Name="CaptionFile" Foreground="#9A9A9A" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Toolbar (hides itself when the mouse is still) -->
            <Border x:Name="Toolbar" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14"
                    Padding="4" CornerRadius="10" Background="{StaticResource OverlayBrush}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnOpen" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Open folder (O)" Click="BtnOpen_Click" />
                    <Rectangle Width="1" Margin="4,8" Fill="#44FFFFFF" />
                    <Button x:Name="BtnPrev" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous (←)" Click="BtnPrev_Click" />
                    <Button x:Name="BtnPlay" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="Pause / play (Space)" Click="BtnPlay_Click" />
                    <Button x:Name="BtnNext" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next (→)" Click="BtnNext_Click" />
                    <Rectangle Width="1" Margin="4,8" Fill="#44FFFFFF" />
                    <Button x:Name="BtnOrder" Style="{StaticResource IconButton}" Content="&#xE8CB;" ToolTip="Order (R)" Click="BtnOrder_Click" />
                    <Button x:Name="BtnMap" Style="{StaticResource IconButton}" Content="&#xE707;" ToolTip="Show / hide map (M)" Click="BtnMap_Click" />
                    <Button x:Name="BtnSettings" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings (S)" Click="BtnSettings_Click" />
                    <Button x:Name="BtnFull" Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Full screen (F11)" Click="BtnFull_Click" />
                </StackPanel>
            </Border>

            <!-- Short messages: "Paused", "Order: random" ... -->
            <Border x:Name="Toast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,22,0,0"
                    Padding="16,8" CornerRadius="8" Background="{StaticResource OverlayBrush}"
                    Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="15" />
            </Border>

            <!-- Scan progress -->
            <Border x:Name="Status" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="18"
                    Padding="12,7" CornerRadius="8" Background="{StaticResource OverlayBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="StatusText" Foreground="#E6E6E6" FontSize="13" />
            </Border>

            <!-- Shown before a folder is open, or when it has no photos -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                <TextBlock x:Name="EmptyTitle" Text="Photo Map Viewer" Foreground="White" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Foreground="#B8B8B8" FontSize="15" Margin="0,10,0,22" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="Open a folder of photos. Subfolders are included, and the map shows where each photo was taken." />
                <Button Style="{StaticResource PrimaryButton}" Content="Open folder…" HorizontalAlignment="Center" Click="BtnOpen_Click" />
            </StackPanel>
        </Grid>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="#26282C" ResizeBehavior="PreviousAndNext" Focusable="False"
                      DragCompleted="Splitter_DragCompleted" />

        <!-- Map side -->
        <Grid x:Name="MapArea" Grid.Column="2" Background="#1B1D21">
            <wv2:WebView2 x:Name="Map" />
            <StackPanel x:Name="MapError" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="Collapsed">
                <TextBlock Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                           Text="The map needs the Microsoft Edge WebView2 Runtime." />
                <TextBlock Foreground="#B8B8B8" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center">
                    It's free and usually already on Windows 10/11.
                    <Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/" RequestNavigate="Link_RequestNavigate" Foreground="#7DB7FF">Download it here</Hyperlink>, then restart the app.
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
