<Window x:Class="PhotoMapViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" Height="680" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Icon="app.ico">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="22,2,0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="230" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="0">
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Reset to defaults" Padding="12,5" Click="Reset_Click" />
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Width="90" Padding="0,5" />
                <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" Width="90" Padding="0,5" Margin="0,0,8,0" Click="Ok_Click" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,4,22,18">
            <StackPanel>

                <!-- Slideshow -->
                <TextBlock Text="Slideshow" Style="{StaticResource Section}" Margin="0,8,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Time per photo" VerticalAlignment="Center" />
                    <DockPanel Grid.Column="1">
                        <TextBlock x:Name="SecondsLabel" DockPanel.Dock="Right" Width="60" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Slider x:Name="Seconds" Minimum="2" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" ValueChanged="Slider_Changed" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="Order" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <ComboBox x:Name="Order" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" HorizontalAlignment="Left">
                        <ComboBoxItem Content="By date taken" />
                        <ComboBoxItem Content="By folder and file name" />
                        <ComboBoxItem Content="Random, within the current folder" />
                        <ComboBoxItem Content="Random, all folders" />
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="StartFullscreen" Content="Start in full screen" Margin="0,10,0,4" />

                <TextBlock Text="Caption on the photo" Style="{StaticResource Section}" />
                <CheckBox x:Name="ShowCaption" Content="Show a caption" Checked="Update_Enabled" Unchecked="Update_Enabled" />
                <StackPanel x:Name="CaptionOptions" Margin="22,0,0,0">
                    <CheckBox x:Name="CaptionPlace" Content="Place (country, and town if available)" />
                    <CheckBox x:Name="CaptionDate" Content="Date and time taken" />
                    <CheckBox x:Name="CaptionFileName" Content="Folder and file name" />
                </StackPanel>

                <!-- Map -->
                <TextBlock Text="Map" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Zoom" VerticalAlignment="Center" />
                    <ComboBox x:Name="Zoom" Grid.Column="1" HorizontalAlignment="Left" SelectionChanged="Zoom_Changed">
                        <ComboBoxItem Content="Auto: Netherlands / Europe / World" />
                        <ComboBoxItem Content="Always World" />
                        <ComboBoxItem Content="Always Europe" />
                        <ComboBoxItem Content="Always Netherlands" />
                        <ComboBoxItem Content="Custom zoom (follow the photo)" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Text="Custom zoom level" VerticalAlignment="Center" Margin="0,8,0,0" x:Name="CustomZoomText" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" x:Name="CustomZoomPanel">
                        <TextBlock x:Name="CustomZoomLabel" DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Slider x:Name="CustomZoom" Minimum="3" Maximum="18" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" ValueChanged="Slider_Changed" />
                    </DockPanel>
                </Grid>
                <CheckBox x:Name="AnimateMap" Content="Fly smoothly to the new spot" Margin="0,10,0,4" />

                <CheckBox x:Name="ShowTrail" Content="Show a trail of earlier photos" Checked="Update_Enabled" Unchecked="Update_Enabled" />
                <Grid x:Name="TrailOptions" Margin="22,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="In date/name order" VerticalAlignment="Center" />
                    <DockPanel Grid.Column="1">
                        <TextBlock x:Name="TrailLabel" DockPanel.Dock="Right" Width="80" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Slider x:Name="TrailLength" Minimum="2" Maximum="200" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" ValueChanged="Slider_Changed" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="In random order" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                        <TextBlock x:Name="JumpsLabel" DockPanel.Dock="Right" Width="80" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Slider x:Name="RandomJumps" Minimum="0" Maximum="15" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" ValueChanged="Slider_Changed" />
                    </DockPanel>
                </Grid>

                <CheckBox x:Name="TownNames" Content="Look up town names online (OpenStreetMap)" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Note}"
                           Text="Sends the rounded location of each photo to OpenStreetMap's place-name service. Results are remembered, so each place is looked up only once. Country names always work offline." />

                <CheckBox x:Name="SuggestFromNames" Content="Suggest places from folder and file names (online)" Margin="0,6,0,0" />
                <TextBlock Style="{StaticResource Note}"
                           Text="Used when adding locations: a folder called “Kreta 2012” puts the pin on Crete for you to confirm. Only names with real words are sent; camera numbers and dates are skipped." />

                <!-- Missing GPS -->
                <TextBlock Text="Photos without a location" Style="{StaticResource Section}" />
                <CheckBox x:Name="GuessLocations" Content="Guess from photos taken around the same time" Checked="Update_Enabled" Unchecked="Update_Enabled" />
                <DockPanel x:Name="GuessOptions" Margin="22,4,0,0">
                    <TextBlock Text="Up to" VerticalAlignment="Center" Width="50" />
                    <TextBlock x:Name="WindowLabel" DockPanel.Dock="Right" Width="110" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Slider x:Name="GuessWindow" Minimum="1" Maximum="12" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="Slider_Changed" />
                </DockPanel>
                <TextBlock Style="{StaticResource Note}"
                           Text="Photos from the same folder are preferred. Guessed spots show a dashed marker and ≈ in the caption." />
                <CheckBox x:Name="ShowGuessed" Content="Show guessed locations on the map" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="When there's no location" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox x:Name="NoLocation" Grid.Column="1" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Keep the map where it was" />
                        <ComboBoxItem Content="Zoom out to the world" />
                        <ComboBoxItem Content="Hide the marker" />
                    </ComboBox>
                </Grid>

                <!-- Videos -->
                <TextBlock Text="Videos" Style="{StaticResource Section}" />
                <CheckBox x:Name="ShowVideos" Content="Show videos" IsEnabled="False" />
                <TextBlock Style="{StaticResource Note}" Text="Video playback (with length limit and playback speed) arrives in the next version. Videos are skipped for now." />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
